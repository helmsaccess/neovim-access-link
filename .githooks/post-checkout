#!/usr/bin/env python3
"""Queue Windows-workspace synchronization after a branch checkout."""

from __future__ import annotations

import subprocess
import sys
from pathlib import Path

if len(sys.argv) == 4 and sys.argv[3] == "1":
	worktree = Path(
		subprocess.run(
			("git", "rev-parse", "--show-toplevel"),
			check=True,
			capture_output=True,
			text=True,
		).stdout.strip()
	)
	tool = Path(__file__).resolve().parents[1] / "tools" / "windows_workspace_sync.py"
	raise SystemExit(
		subprocess.run(
			(
				sys.executable,
				str(tool),
				"request",
				"--source",
				str(worktree),
				"--reason",
				"post-checkout",
			),
			check=False,
		).returncode
	)
